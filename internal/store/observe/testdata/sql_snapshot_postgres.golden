SELECT "artifact_row"."job_id", "artifact_row"."attempt", "artifact_row"."kind", "artifact_row"."profile", "artifact_row"."out_rel", "artifact_row"."err_rel", "artifact_row"."out_bytes", "artifact_row"."err_bytes", "artifact_row"."truncated", "artifact_row"."state", "artifact_row"."created_at" FROM "artifact_index" AS "artifact_row" WHERE (job_id = 'job-1') ORDER BY attempt ASC;
SELECT EXISTS (SELECT "artifact_row"."job_id", "artifact_row"."attempt", "artifact_row"."kind", "artifact_row"."profile", "artifact_row"."out_rel", "artifact_row"."err_rel", "artifact_row"."out_bytes", "artifact_row"."err_bytes", "artifact_row"."truncated", "artifact_row"."state", "artifact_row"."created_at" FROM "artifact_index" AS "artifact_row" WHERE (job_id = 'job-1') AND (attempt = 1));
UPDATE "artifact_index" AS "artifact_row" SET state = 'purged' WHERE (job_id = 'job-1') AND (attempt = 1) AND (state = 'available');
UPDATE "artifact_index" AS "artifact_row" SET state = 'purged' WHERE (job_id = 'job-1') AND (attempt = 1) AND (state = 'available');
