BEGIN;
INSERT INTO "job_events" ("seq", "ts_us", "type", "job_id", "job_name", "status", "data", "metadata") VALUES (DEFAULT, <n>, 'job.scheduled', 'job-0', 'demo', 0, '{"k":1}', '{"m":"v"}'), (DEFAULT, <n>, 'job.started', 'job-1', 'demo', 1, NULL, NULL) RETURNING "seq";
DELETE FROM "job_events" AS "event_record" WHERE (seq <= (SELECT COALESCE(MAX(seq)-200000, 0) FROM job_events));
COMMIT;
SELECT "event_record"."seq", "event_record"."ts_us", "event_record"."type", "event_record"."job_id", "event_record"."job_name", "event_record"."status", "event_record"."data", "event_record"."metadata" FROM "job_events" AS "event_record" WHERE (job_id = 'job-0') ORDER BY seq DESC LIMIT 10;
SELECT "event_record"."seq", "event_record"."ts_us", "event_record"."type", "event_record"."job_id", "event_record"."job_name", "event_record"."status", "event_record"."data", "event_record"."metadata" FROM "job_events" AS "event_record" ORDER BY seq DESC LIMIT 5;
SELECT count(*) FROM "job_events" AS "event_record";
BEGIN;
INSERT INTO "write_audit" ("seq", "ts_us", "actor", "actor_kind", "role", "action", "method", "route", "status", "latency_us", "verdict", "exec_verdict", "exec_reason_code", "handler_key", "profile", "job_id", "remote_ip", "user_agent") VALUES (DEFAULT, <n>, 'operator01', 'user', 'operator', 'job.create', 'POST', '/api/v1/jobs', 201, 1001, 'ok', NULL, NULL, NULL, NULL, NULL, '127.0.0.1', 'curl/8'), (DEFAULT, <n>, 'operator02', 'user', 'operator', 'job.create', 'POST', '/api/v1/jobs', 201, 1002, 'ok', NULL, NULL, NULL, NULL, NULL, '127.0.0.1', 'curl/8'), (DEFAULT, <n>, 'operator00', 'user', 'operator', 'job.create', 'POST', '/api/v1/jobs', 201, 1003, 'ok', NULL, NULL, NULL, NULL, NULL, '127.0.0.1', 'curl/8') RETURNING "seq";
DELETE FROM "write_audit" AS "audit_record" WHERE (seq <= (SELECT COALESCE(MAX(seq)-500000, 0) FROM write_audit));
COMMIT;
SELECT count(*) FROM "write_audit" AS "audit_record";
SELECT "audit_record"."seq", "audit_record"."ts_us", "audit_record"."actor", "audit_record"."actor_kind", "audit_record"."role", "audit_record"."action", "audit_record"."method", "audit_record"."route", "audit_record"."status", "audit_record"."latency_us", "audit_record"."verdict", "audit_record"."exec_verdict", "audit_record"."exec_reason_code", "audit_record"."handler_key", "audit_record"."profile", "audit_record"."job_id", "audit_record"."remote_ip", "audit_record"."user_agent" FROM "write_audit" AS "audit_record" ORDER BY seq DESC LIMIT 500;
SELECT count(*) FROM "write_audit" AS "audit_record" WHERE (actor = 'operator01');
SELECT "audit_record"."seq", "audit_record"."ts_us", "audit_record"."actor", "audit_record"."actor_kind", "audit_record"."role", "audit_record"."action", "audit_record"."method", "audit_record"."route", "audit_record"."status", "audit_record"."latency_us", "audit_record"."verdict", "audit_record"."exec_verdict", "audit_record"."exec_reason_code", "audit_record"."handler_key", "audit_record"."profile", "audit_record"."job_id", "audit_record"."remote_ip", "audit_record"."user_agent" FROM "write_audit" AS "audit_record" WHERE (actor = 'operator01') ORDER BY seq DESC LIMIT 2 OFFSET 1;
SELECT count(*) FROM "write_audit" AS "audit_record" WHERE (action = 'job.create') AND (verdict = 'ok') AND (ts_us >= <n>) AND (ts_us <= <n>);
SELECT "audit_record"."seq", "audit_record"."ts_us", "audit_record"."actor", "audit_record"."actor_kind", "audit_record"."role", "audit_record"."action", "audit_record"."method", "audit_record"."route", "audit_record"."status", "audit_record"."latency_us", "audit_record"."verdict", "audit_record"."exec_verdict", "audit_record"."exec_reason_code", "audit_record"."handler_key", "audit_record"."profile", "audit_record"."job_id", "audit_record"."remote_ip", "audit_record"."user_agent" FROM "write_audit" AS "audit_record" WHERE (action = 'job.create') AND (verdict = 'ok') AND (ts_us >= <n>) AND (ts_us <= <n>) ORDER BY seq DESC LIMIT 500;
SELECT count(*) FROM "write_audit" AS "audit_record";
INSERT INTO "artifact_index" AS "artifact_row" ("job_id", "attempt", "kind", "profile", "out_rel", "err_rel", "out_bytes", "err_bytes", "truncated", "state", "created_at") VALUES ('job-1', 1, 'script', 'hello', 'job-1/a.out', 'job-1/a.err', 100, 512, 1, 'available', <n>) ON CONFLICT (job_id, attempt) DO UPDATE SET kind = EXCLUDED.kind, profile = EXCLUDED.profile, out_rel = EXCLUDED.out_rel, err_rel = EXCLUDED.err_rel, out_bytes = EXCLUDED.out_bytes, err_bytes = EXCLUDED.err_bytes, truncated = EXCLUDED.truncated, state = EXCLUDED.state, created_at = EXCLUDED.created_at;
