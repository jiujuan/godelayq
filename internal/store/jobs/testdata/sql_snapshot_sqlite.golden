INSERT INTO "job_attempts" AS "attempt_row" ("job_id", "seq", "status", "trigger_source", "started_at", "finished_at", "duration_ms", "class", "retryable", "exit_code", "signal", "http_status", "error_text") VALUES ('j1', 1, 'running', 'scheduled', <n>, NULL, 0, NULL, NULL, NULL, NULL, NULL, NULL) ON CONFLICT (job_id, seq) DO UPDATE SET status = EXCLUDED.status, trigger_source = EXCLUDED.trigger_source, started_at = EXCLUDED.started_at, finished_at = EXCLUDED.finished_at, duration_ms = EXCLUDED.duration_ms, class = EXCLUDED.class, retryable = EXCLUDED.retryable, exit_code = EXCLUDED.exit_code, signal = EXCLUDED.signal, http_status = EXCLUDED.http_status, error_text = EXCLUDED.error_text;
INSERT INTO "job_attempts" AS "attempt_row" ("job_id", "seq", "status", "trigger_source", "started_at", "finished_at", "duration_ms", "class", "retryable", "exit_code", "signal", "http_status", "error_text") VALUES ('j1', 1, 'failed', 'retry', <n>, <n>, 1000, 'timeout', 1, 0, NULL, NULL, NULL) ON CONFLICT (job_id, seq) DO UPDATE SET status = EXCLUDED.status, trigger_source = EXCLUDED.trigger_source, started_at = EXCLUDED.started_at, finished_at = EXCLUDED.finished_at, duration_ms = EXCLUDED.duration_ms, class = EXCLUDED.class, retryable = EXCLUDED.retryable, exit_code = EXCLUDED.exit_code, signal = EXCLUDED.signal, http_status = EXCLUDED.http_status, error_text = EXCLUDED.error_text;
INSERT INTO "job_attempts" AS "attempt_row" ("job_id", "seq", "status", "trigger_source", "started_at", "finished_at", "duration_ms", "class", "retryable", "exit_code", "signal", "http_status", "error_text") VALUES ('j1', 2, 'running', 'retry', <n>, NULL, 0, NULL, NULL, NULL, NULL, NULL, NULL) ON CONFLICT (job_id, seq) DO UPDATE SET status = EXCLUDED.status, trigger_source = EXCLUDED.trigger_source, started_at = EXCLUDED.started_at, finished_at = EXCLUDED.finished_at, duration_ms = EXCLUDED.duration_ms, class = EXCLUDED.class, retryable = EXCLUDED.retryable, exit_code = EXCLUDED.exit_code, signal = EXCLUDED.signal, http_status = EXCLUDED.http_status, error_text = EXCLUDED.error_text;
UPDATE "job_attempts" AS "attempt_row" SET status = 'abandoned', finished_at = <n>, duration_ms = <n> - started_at WHERE (job_id = 'j1') AND (seq <= 2) AND (status = 'running');
SELECT "attempt_row"."job_id", "attempt_row"."seq", "attempt_row"."status", "attempt_row"."trigger_source", "attempt_row"."started_at", "attempt_row"."finished_at", "attempt_row"."duration_ms", "attempt_row"."class", "attempt_row"."retryable", "attempt_row"."exit_code", "attempt_row"."signal", "attempt_row"."http_status", "attempt_row"."error_text" FROM "job_attempts" AS "attempt_row" WHERE (job_id = 'j1') ORDER BY seq DESC LIMIT 10;
DELETE FROM "job_attempts" AS "attempt_row" WHERE (job_id = 'j1') AND (seq <= (SELECT COALESCE(MAX(seq), 0) - 1 FROM job_attempts WHERE job_id = 'j1'))
